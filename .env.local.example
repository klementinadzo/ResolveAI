# Copy to .env.local (git-ignored) and fill in from your own Supabase project.
# Never commit .env.local or paste these values into chat.
#
# Supabase → Project Settings → API (or "API Keys")
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_…) or legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → "Session pooler" connection string, with your database password.
# Used only by the db:* scripts (create tables, load demo data, generate types).
SUPABASE_DB_URL=

# Optional: AI classification. Free key from https://aistudio.google.com (no card).
AI_API_KEY=
